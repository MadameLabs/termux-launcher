<?xml version="1.0" encoding="utf-8"?>
<!--
  The dictation panel. Mode chips sit above the recording control so the choice is visibly made
  before speaking, which is also when the snapshot freezes it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/voice_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleLine="false"
        app:chipSpacingVertical="0dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/voice_mode_correction"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_mode_correction" />

        <com.google.android.material.chip.Chip
            android:id="@+id/voice_mode_shorten"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_mode_shorten" />

        <com.google.android.material.chip.Chip
            android:id="@+id/voice_mode_emoji"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_mode_emoji" />

        <com.google.android.material.chip.Chip
            android:id="@+id/voice_mode_terminal"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_mode_terminal" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/voice_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textColor="?android:attr/textColorPrimary"
        android:text="@string/voice_state_ready" />

    <TextView
        android:id="@+id/voice_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="?android:attr/textColorSecondary"
        android:text="@string/voice_hint_target" />
</LinearLayout>
