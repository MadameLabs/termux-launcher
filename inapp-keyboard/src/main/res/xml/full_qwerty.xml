<?xml version="1.0" encoding="utf-8"?>
<!--
  MadameLabs fork: the full QWERTY pad, reached by the abc+ key (the Alt key's down-left swipe on
  the launcher layout) and left by the same swipe, which reads >_ here.

  Ten columns, so the letters and the space bar are as wide as on the launcher layout. The top row
  types the shifted symbols !@#$%^&*() with F1 to F12 on the down-right corners; every other
  symbol sits on a letter's corners, filled down-left, then up-left: ` ~ on !, = + on (, - _ on ),
  [ { and ] } on O and P, ; : ' " \ | on J K L, , < . > / ? on B N M. Tab is Q's down-right
  corner, Esc A's. The bottom row is the launcher layout's: Ctrl, Alt, the layouts key (>_ on a tap), the space
  bar, one direction key with the arrows on its swipes, and Enter. Like the numeric pad, it is never in the
  layout ring.
-->
<keyboard bottom_row="false" name="Full QWERTY" script="latin">
  <row>
    <key c="!" sw="`" nw="~" se=":keyevent symbol='F₁' flags='small':131"/>
    <key c="\@" se=":keyevent symbol='F₂' flags='small':132"/>
    <key c="\#" se=":keyevent symbol='F₃' flags='small':133"/>
    <key c="$" se=":keyevent symbol='F₄' flags='small':134"/>
    <key c="%" se=":keyevent symbol='F₅' flags='small':135"/>
    <key c="^" split_before="true" se=":keyevent symbol='F₆' flags='small':136"/>
    <key c="&amp;" se=":keyevent symbol='F₇' flags='small':137"/>
    <key c="*" se=":keyevent symbol='F₈' flags='small':138"/>
    <key c="(" sw="=" nw="+" ne=":keyevent symbol='F₁₁' flags='small':141" se=":keyevent symbol='F₉' flags='small':139"/>
    <key c=")" sw="-" nw="_" ne=":keyevent symbol='F₁₂' flags='small':142" se=":keyevent symbol='F₁₀' flags='small':140"/>
  </row>
  <row>
    <key c="q" se="tab"/>
    <key c="w"/>
    <key c="e"/>
    <key c="r"/>
    <key c="t"/>
    <key c="y" split_before="true"/>
    <key c="u"/>
    <key c="i"/>
    <key c="o" sw="[" nw="{"/>
    <key c="p" sw="]" nw="}"/>
  </row>
  <row>
    <key shift="0.5" c="a" se="esc"/>
    <key c="s"/>
    <key c="d"/>
    <key c="f"/>
    <key c="g"/>
    <key c="h" split_before="true"/>
    <key c="j" sw=";" nw=":"/>
    <key c="k" sw="'" nw="&quot;"/>
    <key c="l" sw="\\" nw="|"/>
  </row>
  <row>
    <key width="1.5" role="action" c="shift" ne="capslock"/>
    <key c="z"/>
    <key c="x"/>
    <key c="c"/>
    <key c="v"/>
    <key c="b" split_before="true" sw="," nw="&lt;"/>
    <key c="n" sw="." nw="&gt;"/>
    <key c="m" sw="/" nw="\?"/>
    <key width="1.5" role="action" c="backspace" ne="delete"/>
  </row>
  <row height="0.95">
    <key width="1.7" role="action" c="ctrl" ne="loc switch_clipboard" sw="loc meta" se="switch_numeric"/>
    <key width="1.3" role="action" c="alt" sw="switch_text" se="config"/>
    <key width="1.0" role="action" c="switch_text" sw="switch_symbols" ne="switch_numeric" se="switch_greekmath"/>
    <key width="3.0" role="space_bar" c="space" split_at="1.5" w="cursor_left" e="cursor_right" s="switch_backward"
         n="tool:app.command_palette:󱎱"
         nw="tool:window.previous:󰜳" ne="tool:window.next:󰜶"
         sw="tool:session.previous:󰜹" se="tool:session.next:󰜰"/>
    <key width="1.3" role="action" c="loc compose" nw="home" ne="page_up" sw="page_down" se="end" w="left" e="right" n="up" s="down"/>
    <key width="1.7" role="action" c="enter" n="tool:voice.dictate:"/>
  </row>
</keyboard>
